[Unit]
Description=TYI E100 Orin USB camera MJPEG owner
After=network.target

[Service]
Type=simple
User=tfboys_nano
Group=tfboys_nano
SupplementaryGroups=video
WorkingDirectory=/home/tfboys_nano/TYI_E100_Firmware
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -e /dev/v4l/by-id/usb-HD_Camera_Manufacturer_USB_2.0_Camera-video-index0
ExecStart=/usr/bin/python3 /home/tfboys_nano/TYI_E100_Firmware/camera/orin_camera_stream.py --device /dev/v4l/by-id/usb-HD_Camera_Manufacturer_USB_2.0_Camera-video-index0 --width 1280 --height 720 --capture-fps 60 --stream-fps 15 --max-frame-age 2.0
Restart=always
RestartSec=2
TimeoutStopSec=8
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
