IMAGE_NAME=tyi/tyi_e100:0.1.2-mission-safe-r6.1
FLIGHT_CORE_CONTAINER_NAME=flight-core
CONTROL_GATEWAY_IMAGE=tyi/control-gateway:0.1.0-local
CONTROL_GATEWAY_CONTAINER_NAME=control-gateway
CONTROL_GATEWAY_HTTP_PORT=8443
CONTROL_GATEWAY_DISCOVERY_PORT=19001
CONTROL_GATEWAY_SHARED_CODE=246810
CONTROL_GATEWAY_PAIRING_MODE=development
CONTROL_GATEWAY_NONCE_TTL_SEC=180
CONTROL_GATEWAY_ACCESS_TOKEN_TTL_SEC=43200
CONTROL_GATEWAY_REFRESH_TOKEN_TTL_SEC=2592000
CONTROL_GATEWAY_MAX_PAIRED_CLIENTS=64
CONTROL_GATEWAY_STALE_CLIENT_TTL_SEC=604800
CONTROL_GATEWAY_REQUIRE_PRODUCTION_SECURITY=false
MEDIA_GATEWAY_IMAGE=tyi/media-gateway:0.1.0-local
MEDIA_GATEWAY_CONTAINER_NAME=media-gateway
MEDIA_GATEWAY_HTTP_PORT=8555
MEDIA_CAMERA_PREFERRED_DEVICE=/dev/v4l/by-path/platform-3610000.xhci-usb-0:1:1.3-video-index0
DEVICE_ID=tyi-e100-dev
DISPLAY_NAME=TYI E100
FIRMWARE_VERSION=0.1.2
CONTROL_GATEWAY_VERSION=0.1.0

DISPLAY=
ROS_MASTER_PORT=11311
FCU_URL=/dev/ttyTHS0:921600
GCS_URL=udp://0.0.0.0:14555@192.168.0.126:14551
MAVROS_TGT_SYSTEM=51
MAVROS_TGT_COMPONENT=1
MAVROS_FCU_PROTOCOL=v2.0
MAVROS_LOG_OUTPUT=screen
MAVROS_RESPAWN=false

LIVOX_BD_LIST=147MDM5T0020051
LIVOX_FRAME_ID=livox_frame
LIVOX_PUBLISH_FREQ=20.0

STRICT_TOPIC_HEALTHCHECK=false
TYI_TIMEBASE_MODE=monotonic_raw_internal
TYI_TIMEBASE_FILE=/opt/tyi/timebase/tyi_timebase.env

TYI_OPERATION_MODE=dev
TYI_PLANNER_GOAL_REQUIRES_FLIGHT_MODE=true

PLANNER_IMAGE=tyi/planner:0.1.0-local
PLANNER_CONTAINER_NAME=tyi-planner
TYI_PLANNER_AUTOSTART=true
TYI_PLANNER_DRONE_ID=0
TYI_PLANNER_FLIGHT_TYPE=1
TYI_PLANNER_ODOM_TOPIC=/tyi/e100/fastlio2/odom
TYI_PLANNER_LIVOX_TOPIC=/livox/lidar
TYI_PLANNER_CMD_OUTPUT_TOPIC=/tyi_planner/mavros/setpoint_raw/local_shadow
TYI_PLANNER_ENABLE_ACCELERATION=false
TYI_PLANNER_TARGET_X=2.0
TYI_PLANNER_TARGET_Y=0.0
TYI_PLANNER_TARGET_Z=1.0
TYI_PLANNER_MAX_VEL=0.8
TYI_PLANNER_MAX_ACC=1.2
TYI_PLANNER_POINT_STRIDE=6
REALSENSE_ROS_ENABLE=false
REALSENSE_AUTOSTART=false
REALSENSE_RELEASE_AFTER_QUERY=false
REALSENSE_RGBD_SNAPSHOT_ENABLE=true
REALSENSE_SNAPSHOT_REQUIRE_CACHED=true
REALSENSE_SNAPSHOT_CACHE_MAX_AGE_SEC=0.35
REALSENSE_RGBD_STREAM_ENABLE=true
REALSENSE_RGBD_STREAM_FPS=15
REALSENSE_RGBD_ALIGN_FPS=2
REALSENSE_MJPEG_MAX_FPS=15
REALSENSE_JPEG_QUALITY=75
REALSENSE_JPEG_OPTIMIZE=false
REALSENSE_JPEG_SUBSAMPLING=2

MEDIA_GATEWAY_SNAPSHOT_URL=rtsp://127.0.0.1:8554/camera-480p15

SIM_TIME_PUBLISH_HZ=100
MEDIA_GATEWAY_ENCODER=auto
TYI_PLANNER_WATCHDOG_INTERVAL_SEC=20
