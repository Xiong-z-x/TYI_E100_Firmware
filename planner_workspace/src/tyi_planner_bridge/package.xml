  <version>0.1.0</version>
  <description>Bridge adapters for running EGO planner on TYI UAV platforms.</description>

  <maintainer email="richard@example.com">RichardH</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>bspline_opt</depend>
