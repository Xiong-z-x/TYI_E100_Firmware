{
  "service": {
    "listenHost": "0.0.0.0",
    "port": 8765,
    "maxFrameAgeSec": 2.5
  },
  "source": {
    "snapshotUrl": "http://127.0.0.1:8090/snapshot.jpg",
    "healthUrl": "http://127.0.0.1:8090/healthz",
    "timeoutSec": 1.5
  },
  "inference": {
    "backend": "speciesnet-tensorrt",
    "detectorEnginePath": "/opt/uav/models/megadetector-v5a-1280-fp16.engine",
    "classifierEnginePath": "/opt/uav/models/speciesnet-v4.0.3a-480-fp16.engine",
    "classifierLabelsPath": "/opt/uav/models/speciesnet-v4.0.3a-labels.txt",
    "detectorInputSize": 1280,
    "classifierInputSize": 480,
    "classes": [
      "elephant",
      "tiger",
      "wolf",
      "monkey",
      "peacock"
    ],
    "targetFps": 2.0,
    "detectorConfidence": 0.20,
    "closedSetConfidence": 0.60,
    "minimumNativeGroupMass": 0.20,
    "minimumMargin": 0.15,
    "iou": 0.45,
    "maxDetections": 20,
    "maxBoxWidthRatio": 0.70,
    "maxBoxHeightRatio": 0.70,
    "maxBoxAreaRatio": 0.25,
    "minBorderMarginRatio": 0.005
  },
  "tracking": {
    "confirmHits": 3,
    "maxMissed": 5
  },
  "output": {
    "streamFps": 5.0,
    "jpegQuality": 82,
    "eventLogPath": "/opt/tyi/logs/vision-gateway/events.jsonl"
  }
}
