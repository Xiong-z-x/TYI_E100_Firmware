{
  "service": {
    "listenHost": "0.0.0.0",
    "port": 8765,
    "maxFrameAgeSec": 2.5
  },
  "source": {
    "snapshotUrl": "http://127.0.0.1:8090/snapshot.jpg",
    "healthUrl": "http://127.0.0.1:8090/healthz",
    "timeoutSec": 1.5
  },
  "inference": {
    "backend": "yolo-seg-tensorrt",
    "modelPath": "/opt/uav/models/yolo11s-seg-nuedc-h-v2-hardneg.engine",
    "modelInputSize": 768,
    "classes": [
      "elephant",
      "tiger",
      "wolf",
      "monkey",
      "peacock"
    ],
    "targetFps": 10.0,
    "closedSetConfidence": 0.70,
    "iou": 0.45,
    "maxDetections": 20,
    "maxBoxWidthRatio": 0.70,
    "maxBoxHeightRatio": 0.70,
    "maxBoxAreaRatio": 0.25,
    "minBorderMarginRatio": 0.005
  },
  "tracking": {
    "confirmHits": 3,
    "confirmWindow": 5,
    "fastConfirmHits": 2,
    "fastConfirmWindow": 3,
    "fastConfidence": 0.85,
    "maxMissed": 5
  },
  "output": {
    "streamFps": 5.0,
    "jpegQuality": 82,
    "eventLogPath": "/opt/tyi/logs/vision-gateway/events.jsonl"
  }
}
