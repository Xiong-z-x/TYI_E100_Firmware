{
  "device": {
    "frameId": "robot/odom",
    "gatewayVersion": "0.1.0"
  },
  "network": {
    "httpPort": 8666,
    "wsPath": "/v1/ws"
  },
  "telemetry": {
    "poseHz": 20,
    "plannerHz": 20
  },
  "observations": {
    "historySec": 10,
    "snapshotTtlSec": 30,
    "snapshotCacheLimit": 128,
    "maxRgbDepthDtSec": 0.03,
    "maxPoseDtSec": 0.1,
    "maxPointcloudDtSec": 0.25,
    "requireBracketedPose": true,
    "allowCachedMapFallback": true,
    "cachedMapFallbackMaxAgeSec": 300
  },
  "auth": {
    "sharedSecret": "tyi-pointcloud-dev-secret",
    "ticketTtlSec": 300
  },
  "streaming": {
    "tileSizeMeters": 4.0,
    "chunkTargetBytes": 262144,
    "snapshotPacketsPerPoll": 8,
    "deltaPacketsPerPoll": 3,
    "removedTileHistoryLimit": 2048,
    "visibleTileRadius": 1,
    "visibleTileLimit": 9,
    "fullDetailTileRadius": 0,
    "farTileMinDetailRatio": 0.35,
    "localMapRetentionRadius": 2,
    "localMapRetentionLimit": 16
  },
  "sources": {
    "keyframeTopic": "/robot/fastlio2/pointcloud/keyframe",
    "odomTopic": "/robot/fastlio2/odom",
    "plannerTrajectoryTopic": "/tyi_planner/predicted_path",
    "plannerStatusTopic": "/tyi_planner/status",
    "liveTopic": "/robot/fastlio2/pointcloud/deskewed",
    "enableLiveLayer": false,
    "keyframePreSampleMaxPoints": 1200000,
    "livePreSampleMaxPoints": 70000,
    "accumulateDenseToMap": true,
    "denseToMapMinIntervalSec": 1.0
  },
  "map": {
    "voxelSize": 0.045,
    "cacheMaxPoints": 120000,
    "denseVoxelSize": 0.055
  },
  "live": {
    "voxelSize": 0.08,
    "retentionSec": 1.0
  },
  "profiles": [
    {
      "name": "balanced",
      "mapMaxPoints": 60000,
      "liveMaxPoints": 0,
      "updateHz": 3,
      "compression": "zlib"
    },
    {
      "name": "detail",
      "mapMaxPoints": 120000,
      "liveMaxPoints": 0,
      "updateHz": 4,
      "compression": "zlib"
    },
    {
      "name": "live",
      "mapMaxPoints": 80000,
      "liveMaxPoints": 100000,
      "updateHz": 4,
      "compression": "zlib"
    }
  ],
  "health": {
    "keyframeStaleSec": 120,
    "odomStaleSec": 5,
    "liveStaleSec": 3
  },
  "recovery": {
    "registrationTimeoutSec": 12,
    "watchdogCheckIntervalSec": 2,
    "startupGraceSec": 20,
    "rosStaleExitSec": 12,
    "pointcloudStaleExitSec": 130,
    "pointcloudStaleWarnIntervalSec": 30,
    "pointcloudStaleExitRequiresEmptyMap": true
  }
}
